#!/bin/bash
# OctagonOS GPU Driver Setup
# Detects GPU and offers to install appropriate proprietary drivers

set -e

if [ "$EUID" -ne 0 ]; then
    exec pkexec "$0" "$@"
fi

echo "🖥️  OctagonOS GPU Driver Setup"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Detect GPU
NVIDIA_GPU=$(lspci | grep -i nvidia | head -1)
AMD_GPU=$(lspci | grep -i 'amd.*vga\|amd.*3d\|radeon' | head -1)
INTEL_GPU=$(lspci | grep -i 'intel.*vga\|intel.*graphics' | head -1)

if [ -n "$NVIDIA_GPU" ]; then
    echo "🟢 NVIDIA GPU detected: $NVIDIA_GPU"
    echo ""
    echo "Options:"
    echo "  1) Install NVIDIA proprietary drivers (recommended for gaming)"
    echo "  2) Keep Nouveau open-source drivers"
    echo "  3) Skip"
    read -p "Select [1-3]: " choice
    
    case $choice in
        1)
            echo "📦 Installing NVIDIA drivers..."
            apt update
            apt install -y nvidia-driver nvidia-settings nvidia-vulkan-common \
                          libnvidia-gl-535 nvidia-driver-libs:i386 2>/dev/null || \
            apt install -y nvidia-driver nvidia-settings 2>/dev/null || \
            echo "⚠️  Could not install NVIDIA drivers. Please check available packages."
            
            # Configure for Wayland + NVIDIA
            cat > /etc/modprobe.d/nvidia-drm.conf << 'EOF'
options nvidia-drm modeset=1
options nvidia NVreg_PreserveVideoMemoryAllocations=1
EOF
            update-initramfs -u
            echo "✅ NVIDIA drivers installed. Reboot required."
            ;;
        2) echo "ℹ️  Keeping Nouveau drivers." ;;
        3) echo "⏭️  Skipped." ;;
    esac
fi

if [ -n "$AMD_GPU" ]; then
    echo "🔴 AMD GPU detected: $AMD_GPU"
    echo "✅ AMD GPUs use the open-source AMDGPU driver (already active)."
    echo "ℹ️  For Vulkan: mesa-vulkan-drivers is pre-installed."
    
    # Check if ROCm could be useful
    echo ""
    echo "Optional: Install AMD ROCm for GPU compute? (y/N)"
    read -p "> " rocm_choice
    if [ "$rocm_choice" = "y" ] || [ "$rocm_choice" = "Y" ]; then
        echo "📦 See: https://rocm.docs.amd.com for ROCm installation."
    fi
fi

if [ -n "$INTEL_GPU" ]; then
    echo "🔵 Intel GPU detected: $INTEL_GPU"
    echo "✅ Intel GPUs use the open-source i915/xe driver (already active)."
    echo "ℹ️  Vulkan via intel-media-va-driver is available."
fi

if [ -z "$NVIDIA_GPU" ] && [ -z "$AMD_GPU" ] && [ -z "$INTEL_GPU" ]; then
    echo "⚠️  No dedicated GPU detected."
fi

echo ""
echo "🔍 Vulkan status:"
vulkaninfo --summary 2>/dev/null | head -20 || echo "  vulkaninfo not available or no Vulkan support detected."
echo ""
echo "Done! Reboot if you installed new drivers."
