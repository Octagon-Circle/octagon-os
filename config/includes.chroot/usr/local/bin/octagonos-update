#!/bin/bash
# OctagonOS System & Interface OTA Updater
# Updates Debian packages, Flatpaks, and syncs OctagonOS system/UI components from GitHub

set -e

if [ "$EUID" -ne 0 ]; then
    exec pkexec "$0" "$@"
fi

echo "╔══════════════════════════════════════════════════════════╗"
echo "║           ⬡ OctagonOS System & OTA Updater               ║"
echo "╚══════════════════════════════════════════════════════════╝"
echo ""

REPO_URL="https://raw.githubusercontent.com/Octagon-Circle/octagon-os/main"

# 1. Check for OctagonOS UI & Core Script Upgrades (OTA from GitHub)
echo "🌐 [1/3] Comprobando actualizaciones de OctagonOS en GitHub..."
REMOTE_VERSION=$(curl -fsSL "${REPO_URL}/config/includes.chroot/etc/os-release" 2>/dev/null | grep -oP 'VERSION_ID="\K[^"]+' || echo "")
LOCAL_VERSION=$(grep -oP 'VERSION_ID="\K[^"]+' /etc/os-release 2>/dev/null || echo "1.0")

if [ -n "$REMOTE_VERSION" ] && [ "$REMOTE_VERSION" != "$LOCAL_VERSION" ]; then
    echo "✨ ¡Nueva versión mayor disponible!: OctagonOS ${REMOTE_VERSION} (Actual: ${LOCAL_VERSION})"
    read -p "¿Deseas actualizar la interfaz y componentes a OctagonOS ${REMOTE_VERSION}? (Y/n): " confirm_major
    if [ "$confirm_major" != "n" ] && [ "$confirm_major" != "N" ]; then
        echo "🚀 Actualizando componentes de OctagonOS..."
        
        # Update core scripts
        curl -fsSL "${REPO_URL}/config/includes.chroot/usr/local/bin/octagonos-hello" -o /usr/local/bin/octagonos-hello 2>/dev/null || true
        curl -fsSL "${REPO_URL}/config/includes.chroot/usr/local/bin/octagonos-gamemode" -o /usr/local/bin/octagonos-gamemode 2>/dev/null || true
        curl -fsSL "${REPO_URL}/config/includes.chroot/usr/local/bin/octagonos-info" -o /usr/local/bin/octagonos-info 2>/dev/null || true
        chmod +x /usr/local/bin/octagonos-* 2>/dev/null || true
        
        # Update global desktop configs (/etc/skel/)
        mkdir -p /etc/skel/.config/hypr /etc/skel/.config/waybar
        curl -fsSL "${REPO_URL}/config/includes.chroot/etc/skel/.config/hypr/hyprland.conf" -o /etc/skel/.config/hypr/hyprland.conf 2>/dev/null || true
        curl -fsSL "${REPO_URL}/config/includes.chroot/etc/skel/.config/waybar/config" -o /etc/skel/.config/waybar/config 2>/dev/null || true
        curl -fsSL "${REPO_URL}/config/includes.chroot/etc/skel/.config/waybar/style.css" -o /etc/skel/.config/waybar/style.css 2>/dev/null || true
        
        # Update os-release
        curl -fsSL "${REPO_URL}/config/includes.chroot/etc/os-release" -o /etc/os-release 2>/dev/null || true
        
        echo "✅ Interfaz y componentes actualizados a OctagonOS ${REMOTE_VERSION}!"
    fi
else
    echo "✅ Componentes de OctagonOS al día (Versión actual: ${LOCAL_VERSION})"
fi

echo ""

# 2. Update Debian System Packages & Kernels
echo "📋 [2/3] Actualizando paquetes base y kernel (apt)..."
apt update

UPGRADEABLE=$(apt list --upgradeable 2>/dev/null | grep -c upgradable || true)
if [ "$UPGRADEABLE" -gt 0 ]; then
    echo "📦 $UPGRADEABLE paquetes del sistema se pueden actualizar."
    read -p "¿Proceder con la actualización de paquetes? (Y/n): " confirm
    if [ "$confirm" != "n" ] && [ "$confirm" != "N" ]; then
        apt upgrade -y
        apt autoremove -y
        apt autoclean
        echo "✅ Paquetes del sistema actualizados."
    fi
else
    echo "✅ Todos los paquetes del sistema están actualizados."
fi

echo ""

# 3. Update Flatpak applications (Steam tools, browsers, etc.)
if command -v flatpak &>/dev/null; then
    echo "📦 [3/3] Actualizando aplicaciones Flatpak..."
    flatpak update -y 2>/dev/null || true
fi

echo ""
if [ -f /var/run/reboot-required ]; then
    echo "🔄 Se ha actualizado el Kernel u otros componentes críticos. Se recomienda reiniciar."
fi

echo "╔══════════════════════════════════════════════════════════╗"
echo "║              ✅ Sistema totalmente al día                ║"
echo "╚══════════════════════════════════════════════════════════╝"
