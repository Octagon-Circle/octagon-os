# Mako notification daemon configuration
font=Noto Sans 10
width=340
height=120
margin=14
padding=12
border-size=2
border-color=#00d4ff
border-radius=10
background-color=#0c0d18f0
text-color=#ffffff
default-timeout=5000
icons=1
max-icon-size=48

[urgency=high]
border-color=#ff0055
default-timeout=0

[urgency=low]
border-color=#7b2ff7
default-timeout=3000
