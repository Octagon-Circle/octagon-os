{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "debian",
    "color": {
      "1": "cyan",
      "2": "magenta"
    }
  },
  "display": {
    "separator": " ⬡ "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "format": "{3} ({12})"
    },
    {
      "type": "kernel",
      "format": "{1} {2} (BORE & x86-64-v3)"
    },
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "break",
    "colors"
  ]
}
